# Asil Kafe - Ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi yazın: copy .env.example .env

PORT=3000

# Personel paneli (/admin) ve sipariş listesi için gizli anahtar.
# Boş bırakılırsa panel yalnızca sunucu bilgisayarından (localhost) açılır.
ADMIN_TOKEN=

# Başka bir adresten API çağrılacaksa izin verilen origin (varsayılan: sadece aynı origin)
CORS_ORIGIN=

# MySQL (ulaşılamazsa siparişler bellekte tutulur, sunucu kapanınca silinir)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asil_kafe
# MySQL'i hiç denemeden bellek modunda çalışmak için: USE_MEMORY_STORE=1
